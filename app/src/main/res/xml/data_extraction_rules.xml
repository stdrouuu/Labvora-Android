<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules (API 31+): cart + foto profil dikecualikan dari cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="labvora_cart_pref.xml" />
        <exclude domain="file" path="profile_photos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="labvora_cart_pref.xml" />
        <exclude domain="file" path="profile_photos/" />
    </device-transfer>
</data-extraction-rules>
